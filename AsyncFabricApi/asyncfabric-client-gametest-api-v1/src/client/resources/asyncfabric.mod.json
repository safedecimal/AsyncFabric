{
  "schemaVersion": 1,
  "id": "asyncfabric-client-gametest-api-v1",
  "name": "AsyncFabric Client Game Test API (v1)",
  "version": "${version}",
  "environment": "client",
  "license": "Apache-2.0",
  "icon": "assets/asyncfabric-client-gametest-api-v1/icon.png",
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "authors": [
    "FabricMC"
  ],
  "depends": {
    "asyncfabricloader": ">=0.20.1",
    "asyncfabric-resource-loader-v1": "*",
    "asyncfabric-networking-api-v1": "*"
  },
  "description": "Allows registration of client game tests.",
  "entrypoints": {
    "client": [
      "net.asyncfabric.impl.client.gametest.FabricClientGameTestImpl"
    ]
  },
  "mixins": [
    "asyncfabric-client-gametest-api-v1.mixins.json"
  ],
  "accessWidener": "asyncfabric-client-gametest-api-v1.classtweaker",
  "custom": {
    "fabric-api:module-lifecycle": "experimental"
  }
}
