{
  "schemaVersion": 1,
  "id": "asyncfabric-api-lookup-api-v1",
  "name": "AsyncFabric API Lookup API (v1)",
  "version": "${version}",
  "environment": "*",
  "license": "Apache-2.0",
  "icon": "assets/asyncfabric-api-lookup-api-v1/icon.png",
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "authors": [
    "FabricMC"
  ],
  "depends": {
    "asyncfabricloader": ">=0.20.1",
    "asyncfabric-api-base": "*",
    "asyncfabric-lifecycle-events-v1": "*"
  },
  "entrypoints": {
    "main": [
      "net.asyncfabric.impl.lookup.ApiLookupImpl"
    ]
  },
  "description": "A universal way to expose and query APIs",
  "mixins": [
    "asyncfabric-api-lookup-api-v1.mixins.json"
  ],
  "custom": {
    "fabric-api:module-lifecycle": "stable"
  }
}
