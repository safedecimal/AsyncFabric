{
  "schemaVersion": 1,
  "id": "asyncfabric-renderer-indigo",
  "name": "AsyncFabric Renderer - Indigo",
  "version": "${version}",
  "environment": "client",
  "license": "Apache-2.0",
  "icon": "assets/asyncfabric-renderer-indigo/icon.png",
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "authors": [
    "FabricMC"
  ],
  "depends": {
    "asyncfabricloader": ">=0.20.1",
    "minecraft": ">=26.1-rc.2",
    "asyncfabric-api-base": "*",
    "asyncfabric-renderer-api-v1": "*"
  },
  "description": "Default implementation of the AsyncFabric Renderer API.",
  "mixins": [
    "asyncfabric-renderer-indigo.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "net.asyncfabric.impl.client.indigo.Indigo"
    ]
  },
  "custom": {
    "fabric-api:module-lifecycle": "stable"
  },
  "accessWidener" : "asyncfabric-renderer-indigo.classtweaker"
