{
  "schemaVersion": 1,
  "id": "asyncfabric-content-registries-v0",
  "name": "AsyncFabric Content Registries (v0)",
  "version": "${version}",
  "environment": "*",
  "license": "Apache-2.0",
  "icon": "assets/asyncfabric-content-registries-v0/icon.png",
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "authors": [
    "FabricMC"
  ],
  "depends": {
    "asyncfabricloader": ">=0.20.1",
    "asyncfabric-api-base": "*",
    "asyncfabric-lifecycle-events-v1": "*",
    "asyncfabric-resource-loader-v1": "*",
    "asyncfabric-item-api-v1": "*"
  },
  "description": "Adds registries for vanilla mechanics that are missing them.",
  "mixins": [
    "asyncfabric-content-registries-v0.mixins.json",
