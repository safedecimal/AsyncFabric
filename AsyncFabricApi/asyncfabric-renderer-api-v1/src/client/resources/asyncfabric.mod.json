{
  "schemaVersion": 1,
  "id": "asyncfabric-renderer-api-v1",
  "name": "AsyncFabric Renderer API (v1)",
  "version": "${version}",
  "environment": "client",
  "license": "Apache-2.0",
  "icon": "assets/asyncfabric-renderer-api-v1/icon.png",
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "authors": [
    "FabricMC"
  ],
  "entrypoints": {
    "client": [
      "net.asyncfabric.impl.client.renderer.DebugOverlayClient"
    ]
  },
  "depends": {
    "asyncfabricloader": ">=0.20.1",
    "minecraft": ">=26.1-rc.2",
    "asyncfabric-api-base": "*",
    "asyncfabric-rendering-v1": "*",
    "asyncfabric-transitive-access-wideners-v1": "*"
  },
  "suggests": {
    "asyncfabric-particles-v1": "*"
  },
  "description": "Defines rendering extensions for dynamic/fancy block and item models.",
  "mixins": [
    "asyncfabric-renderer-api-v1.mixins.json"
  ],
  "accessWidener": "asyncfabric-renderer-api-v1.classtweaker",
  "custom": {
    "fabric-api:module-lifecycle": "stable"
  }
}
