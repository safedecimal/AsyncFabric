{
  "schemaVersion": 1,
  "id": "asyncfabric-model-loading-api-v1",
  "name": "AsyncFabric Model Loading API (v1)",
  "version": "${version}",
  "environment": "client",
  "license": "Apache-2.0",
  "icon": "assets/asyncfabric-model-loading-api-v1/icon.png",
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "authors": [
    "FabricMC"
  ],
  "entrypoints": {
    "client": [
      "net.asyncfabric.impl.client.model.loading.CustomUnbakedBlockStateModelInit"
    ]
  },
  "depends": {
    "asyncfabricloader": ">=0.20.1",
    "asyncfabric-api-base": "*",
    "asyncfabric-renderer-api-v1": "*"
  },
  "description": "Provides hooks for model loading.",
  "mixins": [
    {
      "environment": "client",
      "config": "asyncfabric-model-loading-api-v1.mixins.json"
    }
  ],
  "accessWidener": "asyncfabric-model-loading-api-v1.classtweaker",
  "custom": {
    "fabric-api:module-lifecycle": "stable"
  }
}
